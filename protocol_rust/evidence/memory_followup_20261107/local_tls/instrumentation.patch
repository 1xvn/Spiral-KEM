@@ -0,0 +1,8 @@
+// Local definedness instrumentation only. No suppression, writes or declassification.
+extern crate std;
+pub(crate) fn check<T:?Sized>(label:&str,value:&T) {
+ let args=[0x4d43_0005usize,value as *const T as *const () as usize,core::mem::size_of_val(value),0,0,0];
+ let mut result=0usize;
+ unsafe { core::arch::asm!("rol rdi, 3","rol rdi, 13","rol rdi, 61","rol rdi, 51","xchg rbx, rbx",in("rax") args.as_ptr(),inout("rdx") result,lateout("rdi") _,options(nostack)); }
+ if result!=0 { std::eprintln!("DEFINEDNESS CHECK FAILED: {}",label); }
+}
